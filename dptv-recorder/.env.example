# Copy this to .env and adjust as needed, then run: docker compose up -d --build

# Port exposed on the host
HOST_PORT=3000

# Where the app's SQLite database (channels/EPG/settings) lives on the host.
# On Unraid, point this at the container's appdata folder, e.g.:
# DATA_DIR=/mnt/user/appdata/dptv-recorder
DATA_DIR=./data

# Where finished recordings (.ts files) are written on the host.
# Point this at a large/permanent disk - recordings are raw MPEG-TS and not small.
# On Unraid, e.g.:
# RECORDINGS_DIR=/mnt/user/data/media/recording
RECORDINGS_DIR=./recordings

# User/group ID the app runs as inside the container, so files it writes to
# DATA_DIR/RECORDINGS_DIR are owned by a real user on the host rather than root.
# Defaults match Unraid's "nobody:users" (99:100). On non-Unraid Linux hosts,
# set these to `id -u` / `id -g` of the user who should own the files.
PUID=99
PGID=100

# Your local IANA timezone, e.g. Australia/Perth, America/New_York, Europe/London.
# Used to correctly interpret EPG timestamps from providers whose xmltv.php
# doesn't include a UTC offset (common), and for any local-time display on
# the server side. Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# Set to "true" once the app is CONSISTENTLY accessed over HTTPS (e.g.
# exclusively through a Cloudflare Tunnel with proxied DNS, or any other
# TLS-terminating reverse proxy). This makes session cookies "Secure" -
# safe once you're always on HTTPS, but leave it "false" if you also access
# the app directly over plain http:// on your LAN, since the browser won't
# send a Secure cookie back over an insecure connection.
COOKIE_SECURE=false
