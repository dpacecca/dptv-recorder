# Copy this to .env and adjust as needed, then run: docker compose up -d --build

# Port exposed on the host
HOST_PORT=3000

# Where the app's SQLite database (channels/EPG/settings) lives on the host
DATA_DIR=./data

# Where finished recordings (.ts files) are written on the host.
# Point this at a large/permanent disk - recordings are raw MPEG-TS and not small.
RECORDINGS_DIR=./recordings
